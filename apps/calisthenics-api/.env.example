# Copy to .env (git-ignored) for local development: `cp .env.example .env`.
# Postgres started by `pnpm --filter @bpagoaga/calisthenics-api db:up` (compose.yaml).
DATABASE_URL=postgres://calibuddy:calibuddy@localhost:5432/calibuddy
# Local development only; generate a real one for any deployed environment: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-development-secret-change-me-0123456789
# The web app's dev server, which proxies /api to this API.
BETTER_AUTH_URL=https://localhost:5173
PORT=3000
