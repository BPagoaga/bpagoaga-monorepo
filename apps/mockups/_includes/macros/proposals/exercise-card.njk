{#
  Exercise card — un tutoriel d'exercice dans la bibliothèque.

  Params (objet `ex`) :
    name, description — strings
    family — push | pull | legs | core | skill
    level  — 1..5 (difficulté)
    step   — « 3/6 » : position dans sa progression (optionnel)
    target — objectif de validation (« 3 × 8 reps », « 3 × 20 s »)
    duration — durée de la vidéo/lecture
    status — locked | todo | in-progress | mastered
  href — lien vers la fiche exercice (MOCK-205)
#}
{% from "macros/proposals/badge.njk" import badge %}
{% from "macros/proposals/badge-family.njk" import familyBadge %}
{% macro exerciseCard(ex, href='#') %}
{% set statuses = {
  'locked': { label: 'Verrouillé', tone: 'neutral', icon: 'lock' },
  'todo': { label: 'À découvrir', tone: 'neutral', icon: 'circle' },
  'in-progress': { label: 'En cours', tone: 'orange', icon: 'spinner' },
  'mastered': { label: 'Maîtrisé', tone: 'green', icon: 'check' }
} %}
{% set s = statuses[ex.status or 'todo'] %}
{% set locked = ex.status == 'locked' %}
<article class="relative flex flex-col rounded-2xl border border-border bg-surface p-4 transition {{ 'opacity-60' if locked else 'hover:border-primary-60 hover:shadow-elevation-2' }}">
  <div class="flex items-start justify-between gap-2">
    {{ familyBadge(ex.family) }}
    {{ badge(s.label, s.tone, s.icon, 'sm') }}
  </div>
  <h3 class="mt-3 text-title-s">
    {% if locked %}{{ ex.name }}{% else %}<a href="{{ href }}" class="after:absolute after:inset-0 after:rounded-2xl">{{ ex.name }}</a>{% endif %}
  </h3>
  <p class="mt-1 line-clamp-2 flex-1 text-body-s text-muted">{{ ex.description }}</p>
  <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-border pt-3 text-body-xs">
    <div>
      <dt class="text-subtle">Niveau</dt>
      <dd class="mt-0.5 flex gap-0.5" aria-label="{{ ex.level }} sur 5">
        {% for i in range(1, 6) %}<span class="h-1.5 w-3 rounded-full {{ 'bg-accent-100' if i <= ex.level else 'bg-neutral-30' }}" aria-hidden="true"></span>{% endfor %}
      </dd>
    </div>
    <div><dt class="text-subtle">Objectif</dt><dd class="mt-0.5 font-semibold">{{ ex.target }}</dd></div>
    <div><dt class="text-subtle">{{ 'Étape' if ex.step else 'Durée' }}</dt><dd class="mt-0.5 font-semibold">{{ ex.step or ex.duration }}</dd></div>
  </dl>
  {% if locked %}<p class="mt-3 text-body-xs text-muted"><i class="fas fa-lock fa-xs" aria-hidden="true"></i> Valide l'étape précédente pour débloquer.</p>{% endif %}
</article>
{% endmacro %}
