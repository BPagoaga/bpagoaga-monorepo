{#
  Level test — écran d'un test du test de niveau (premier lancement) : progression des
  4 tests, consignes, saisie du maximum au stepper lg, actions collées en bas sous sm.
  Variante résultats : level-test-results.njk.

  Params :
    tests   — [{ name, unit, result, cues[] }]
    current — index du test affiché (les précédents sont validés)
    nextHref — cible de « Valider et continuer »
#}
{% from "macros/proposals/button.njk" import button %}
{% from "macros/proposals/stepper.njk" import stepper %}
{% macro levelTest(tests, current=0, nextHref='#') %}
{% set test = tests[current] %}
<div class="mx-auto max-w-xl px-4 py-8 pb-32 sm:pb-8">
  <ol class="grid grid-cols-4 gap-2" aria-label="Tests">
    {% for t in tests %}
      {% set done = loop.index0 < current %}
      {% set active = loop.index0 == current %}
      <li class="min-w-0" {% if active %}aria-current="step"{% endif %}>
        <span class="block h-1.5 rounded-full {{ 'bg-green-100' if done else ('bg-accent-100' if active else 'bg-neutral-30') }}" aria-hidden="true"></span>
        <span class="mt-1.5 block truncate text-body-xs {{ 'font-semibold' if active else 'text-muted' }}">
          {% if done %}<i class="fas fa-check fa-xs text-green-120" aria-hidden="true"></i> {{ t.name }} · {{ t.result }}{% else %}{{ t.name }}{% endif %}
          <span class="sr-only">{{ ', validé' if done else (', en cours' if active else ', à venir') }}</span>
        </span>
      </li>
    {% endfor %}
  </ol>

  <section class="mt-8" aria-labelledby="test-title-{{ current }}">
    <p class="text-body-xs font-semibold uppercase tracking-wide text-accent-130">Test {{ current + 1 }} sur {{ tests.length }}</p>
    <h1 id="test-title-{{ current }}" class="mt-1 font-display text-title-xl">{{ test.name }} : ton maximum</h1>
    {% set hold = test.unit == 's' %}
    <p class="mt-2 text-body-m text-muted">{% if hold %}Tiens la position le plus longtemps possible et arrête le chrono dès que la forme se dégrade.{% else %}Fais autant de répétitions propres que possible, d'une traite. Les répétitions incomplètes ne comptent pas.{% endif %}</p>

    <ul class="mt-5 space-y-2 rounded-2xl border border-border bg-surface p-4">
      {% for cue in test.cues %}<li class="flex gap-2.5 text-body-s"><i class="fas fa-check mt-1 text-primary-100" aria-hidden="true"></i>{{ cue }}</li>{% endfor %}
    </ul>
    <p class="mt-3 flex gap-2 text-body-xs text-muted"><i class="fas fa-circle-info mt-0.5" aria-hidden="true"></i>Échauffe-toi 5 minutes avant, et repose-toi 3 minutes entre deux tests.</p>

    <div class="mt-6">{{ stepper('Temps tenu' if hold else 'Répétitions', test.result, test.unit, 'test-result-' + current, 'lg') }}</div>
    <div class="mt-2">{{ button('Je ne tiens pas la position' if hold else 'Je n’arrive pas à en faire une', 'ghost', 'sm', extraClass='text-muted') }}</div>
  </section>

  <div class="fixed inset-x-0 bottom-0 flex gap-2 border-t border-border bg-surface p-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:static sm:mt-8 sm:border-0 sm:bg-transparent sm:p-0">
    {{ button('', 'ghost', 'lg', 'chevron-left', ariaLabel='Test précédent') }}
    {{ button('Valider et continuer', 'accent', 'lg', iconRight='arrow-right', href=nextHref, extraClass='flex-1') }}
  </div>
</div>
{% endmacro %}
