{#
  Onboarding header — en-tête des écrans de premier lancement (test de niveau, choix de la
  figure) : pas de navigation principale, seulement la marque, l'étape du parcours et une
  sortie « Passer ».

  Params :
    step, steps — étape courante / nombre d'étapes du premier lancement
    label — nom de l'étape
    skipHref — où mène « Passer »
#}
{% macro onboardingHeader(step, steps, label, skipHref='#') %}
<header class="border-b border-border bg-surface">
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-4">
    <span class="flex items-center gap-2.5">
      <span class="grid size-9 place-items-center rounded-lg bg-accent-100 text-neutral-150" aria-hidden="true"><i class="fas fa-person-running"></i></span>
      <span class="font-display text-title-s">Cali<span class="text-accent-110">Buddy</span></span>
    </span>
    <p class="hidden text-body-s text-muted sm:block">Étape {{ step }} sur {{ steps }} · {{ label }}</p>
    <a href="{{ skipHref }}" class="inline-flex min-h-11 items-center px-2 text-body-s font-medium text-muted hover:text-foreground">Passer</a>
  </div>
</header>
{% endmacro %}
