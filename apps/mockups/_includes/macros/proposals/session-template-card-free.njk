{#
  Free session card — choix « séance libre » à côté des cartes de modèle en mode choix
  (même radio, même état coché), pour partir d'une séance vide.

  Params :
    group — name du groupe radio
    id    — id de la carte (ancre)
#}
{% macro freeSessionCard(group='start', id='') %}
<label {% if id %}id="{{ id }}"{% endif %} class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-dashed border-border bg-surface p-4 hover:border-neutral-60 has-checked:border-solid has-checked:border-accent-100 has-checked:ring-4 has-checked:ring-accent-20 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary-100">
  <input type="radio" name="{{ group }}" class="sr-only" />
  <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-neutral-20 text-subtle" aria-hidden="true"><i class="fas fa-shuffle"></i></span>
  <span class="min-w-0 flex-1"><span class="block text-title-s">Partir de zéro</span><span class="block text-body-s text-muted">Choisis tes exercices dans la bibliothèque.</span></span>
  <span class="grid size-6 shrink-0 place-items-center rounded-full border-2 border-neutral-60 group-has-checked:border-accent-110 group-has-checked:bg-accent-100" aria-hidden="true"><i class="fas fa-check fa-xs hidden text-neutral-150 group-has-checked:inline"></i></span>
</label>
{% endmacro %}
