{#
  Set logger — saisie rapide d'une série pendant la séance, pensée pour une main sur le
  téléphone entre deux séries : gros boutons +/-, valeurs pré-remplies avec la série
  précédente, une seule action principale (« Valider la série »).

  Params :
    exercise  — nom de l'exercice en cours
    setIndex  — numéro de la série à saisir
    reps, load — valeurs pré-remplies (load : « 0 » = poids du corps)
    previous  — [string] séries déjà validées pour cet exercice
    rest      — string : chrono de repos en cours (optionnel, ex. « 1:24 »)
#}
{% from "macros/proposals/button.njk" import button %}
{% from "macros/proposals/stepper.njk" import stepper %}
{% macro setLogger(exercise, setIndex, reps, load='0', previous=[], rest='', idPrefix='set') %}
<section class="rounded-2xl border border-border bg-surface p-4 shadow-elevation-1 sm:p-5" aria-label="Saisie de série" data-mockup-scope>
  <header class="flex items-center justify-between gap-3">
    <div>
      <p class="text-body-xs font-semibold uppercase tracking-wide text-accent-130">Série {{ setIndex }}</p>
      <h3 class="text-title-m">{{ exercise }}</h3>
    </div>
    {% if rest %}
      <p class="flex items-center gap-2 rounded-full bg-primary-10 px-3 py-1.5 text-body-s font-semibold text-primary-120" role="timer" aria-label="Repos écoulé">
        <i class="fas fa-hourglass-half" aria-hidden="true"></i><span class="font-mono">{{ rest }}</span>
      </p>
    {% endif %}
  </header>
  {% if previous.length %}
    <ol class="mt-3 flex flex-wrap items-center gap-1.5 text-body-xs text-muted" aria-label="Séries validées">
      {% for p in previous %}<li class="rounded-md bg-green-10 px-2 py-1 font-mono text-green-130"><i class="fas fa-check fa-xs" aria-hidden="true"></i> {{ p }}</li>{% endfor %}
    </ol>
  {% endif %}
  <div class="mt-4 flex gap-3">
    {{ stepper('Répétitions', reps, '', idPrefix + '-reps') }}
    {{ stepper('Lest', load, 'kg', idPrefix + '-load') }}
  </div>
  <fieldset class="mt-4">
    <legend class="text-body-xs font-medium text-muted">Effort perçu (RPE)</legend>
    <div class="mt-1 grid grid-cols-5 gap-1.5">
      {% for r in [6, 7, 8, 9, 10] %}
        <button type="button" data-mockup-chip aria-pressed="{{ 'true' if r == 8 else 'false' }}"
          class="h-11 rounded-lg border border-border text-body-s font-semibold text-neutral-130 hover:bg-neutral-20 aria-pressed:border-neutral-150 aria-pressed:bg-neutral-150 aria-pressed:text-white">{{ r }}</button>
      {% endfor %}
    </div>
  </fieldset>
  <div class="mt-5 flex gap-2">
    {{ button('Valider la série', 'primary', 'lg', 'check', extraClass='flex-1') }}
    {{ button('', 'secondary', 'lg', 'forward-step', ariaLabel='Passer à l’exercice suivant') }}
  </div>
</section>
{% endmacro %}
