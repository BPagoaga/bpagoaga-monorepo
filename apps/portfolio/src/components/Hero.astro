---
import { ABOUT, SITE, SOCIAL_LINKS } from '../data/site';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
---

<section id="about" aria-labelledby="about-title" class="border-b border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-16 text-center md:px-6 md:py-20">
    <div>
      <h1 id="about-title" class="font-display text-title-xl md:text-display">{SITE.name}</h1>
      <p class="mt-2 font-display text-title-m text-primary-100">{SITE.headline}</p>
    </div>
    <p class="max-w-2xl text-body-l text-muted">{ABOUT}</p>
    <nav aria-label="Social networks">
      <ul class="flex flex-wrap justify-center gap-2">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <ExternalLink
                href={social.href}
                rel="me"
                aria-label={`${social.label} (opens in a new tab)`}
                title={social.label}
                class="grid size-11 place-items-center rounded-xl border border-border text-neutral-130 transition-colors hover:border-primary-100 hover:bg-primary-10 hover:text-primary-110"
              >
                <Icon icon={social.icon} class="size-5" />
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
