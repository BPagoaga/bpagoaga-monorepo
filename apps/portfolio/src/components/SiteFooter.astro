---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <p class="mx-auto max-w-6xl px-4 py-8 text-center text-body-s text-muted md:px-6">
    &copy; <a href={SITE.url} class="font-medium text-foreground hover:text-primary-100">{SITE.name}</a>
    {SITE.since} – {year}
  </p>
</footer>
