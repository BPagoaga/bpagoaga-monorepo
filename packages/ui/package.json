{
  "name": "@bpagoaga/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: Tailwind CSS v4 tokens and base styles shared by every app, documented in Storybook.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "storybook": "dev-certs && storybook dev -p 6006 --https --ssl-cert ../../.certs/localhost.pem --ssl-key ../../.certs/localhost-key.pem --no-open",
    "build-storybook": "storybook build",
    "lint": "vp lint",
    "check-types": "tsc"
  },
  "devDependencies": {
    "@bpagoaga/dev-certs": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.2.0"
  }
}
